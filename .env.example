# Replaniva server configuration

# Optional model assistance. Deterministic planning and approvals work without these.
REPLANIVA_AI_ENABLED=1
BYLLM_DEFAULT_MODEL=gemini/gemini-2.5-flash
REPLANIVA_AI_BACKUP_MODEL=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional model allowance limits.
REPLANIVA_AI_DAILY_CALLS=30
REPLANIVA_AI_DAILY_UNITS=120000
REPLANIVA_AI_SERVER_DAILY_CALLS=60
REPLANIVA_AI_RPM=4
REPLANIVA_AI_MINUTE_UNITS=12000
REPLANIVA_AI_USAGE_PATH=.jac/model-usage.sqlite3

# Google Calendar OAuth and encrypted connection storage.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8001/integrations/google-calendar/callback
REPLANIVA_WEB_URL=http://localhost:8000
GOOGLE_CALENDAR_TIMEZONE=Africa/Nairobi
REPLANIVA_CALENDAR_KEY=
REPLANIVA_CALENDAR_PATH=.jac/calendar.sqlite3

# Optional shared API and local QA settings.
REPLANIVA_URL=http://127.0.0.1:8001
REPLANIVA_TOKEN=
REPLANIVA_QA_USERNAME=
REPLANIVA_QA_PASSWORD=
